for i, data in ipairs(ScriptsData) do
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0.9, 0, 0, 38)
    TabBtn.BackgroundColor3 = Color3.fromRGB(40, 110, 40)
    TabBtn.BackgroundTransparency = 0.3
    TabBtn.Text = data.Name
    TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.TextSize = 13
    TabBtn.TextWrapped = true
    TabBtn.Parent = LeftPanel

    local TabCorner = Instance.new("UICorner")
    TabCorner.CornerRadius = UDim.new(0, 6)
    TabCorner.Parent = TabBtn

    TabBtn.MouseButton1Click:Connect(function()
        SelectedScript = data
        ScriptTitle.Text = data.Name
        ScriptDesc.Text = data.Description
        ScriptImage.Image = data.Image
        
        -- Hiệu ứng nhấn nhẹ trên tab
        TweenService:Create(TabBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 180, 75)}):Play()
        task.wait(0.1)
        TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 110, 40)}):Play()
    end)
end

-- Sự kiện bấm nút Execute Script
ExecuteBtn.MouseButton1Click:Connect(function()
    local origText = ExecuteBtn.Text
    ExecuteBtn.Text = "Executing..."
    TweenService:Create(ExecuteBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(39, 174, 96)}):Play()
    
    -- Chạy kịch bản được chọn
    task.spawn(function()
        pcall(SelectedScript.Code)
    end)
    
    task.wait(0.8)
    ExecuteBtn.Text = "Executed!"
    task.wait(0.8)
    ExecuteBtn.Text = origText
    TweenService:Create(ExecuteBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(46, 204, 113)}):Play()
end)

-- ==========================================
-- 5. HIỆU ỨNG ĐỘNG KHI BẤM NÚT TRÒN CNP
-- ==========================================
local IsOpen = false
local TargetSize = UDim2.new(0, 500, 0, 310) -- Kích thước chuẩn của Menu chính

ToggleButton.MouseButton1Click:Connect(function()
    -- Hiệu ứng nảy (Pulse/Bounce) cho nút tròn CNP
    local shrink = TweenService:Create(ToggleButton, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 46, 0, 46)})
    local expand = TweenService:Create(ToggleButton, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 55, 0, 55)})
    
    shrink:Play()
    shrink.Completed:Connect(function()
        expand:Play()
    end)

    -- Hiệu ứng đóng/mở Menu chính
    IsOpen = not IsOpen
    if IsOpen then
        MainFrame.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = TargetSize}):Play()
    else
        local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
        closeTween:Play()
        closeTween.Completed:Connect(function()
            if not IsOpen then
                MainFrame.Visible = false
            end
        end)
    end
end)
